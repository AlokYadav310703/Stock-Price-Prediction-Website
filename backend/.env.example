# ── App ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────
# Local dev (no Docker/Postgres needed):
DATABASE_URL=sqlite:///./aapl_predictor.db
# Production example (Neon/Supabase/Render/Railway free-tier Postgres):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# ── Stock ────────────────────────────────────────────────────────────────
STOCK_SYMBOL=AAPL
STOCK_NAME=Apple Inc.

# ── News (optional — features fall back to neutral if unset) ─────────────
NEWS_API_KEY=

# ── ChromaDB / HuggingFace (optional — similarity search disabled if unset)
HF_REPO_ID=alokyadav310703/Similarity
HF_COLLECTION_NAME=aapl_memory_v2
CHROMA_CACHE_DIR=./.cache/chroma

# ── Models ───────────────────────────────────────────────────────────────
MODEL_DIR=../models
MODEL_VERSION=v2.3.1
CORRECTION_MODEL_FILENAME=Best_Adjustment_Model.pkl

# ── Direction-correctness rule ─────────────────────────────────────────
DIRECTION_RULE=previous_close

# ── Monitoring thresholds ───────────────────────────────────────────────
DIRECTIONAL_ACCURACY_WARNING_THRESHOLD=55.0
DRIFT_PSI_WARNING_THRESHOLD=0.15
DRIFT_PSI_HIGH_THRESHOLD=0.25
DATA_QUALITY_VOLUME_SPIKE_PCT=15.0

# ── Alerts (all optional; DB + dashboard alerts always work) ─────────────
ALERT_EMAIL_ENABLED=false
ALERT_DISCORD_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=
